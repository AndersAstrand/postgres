--------------------------------------------
 
(1 row)

CREATE TABLE test_enc2 (id SERIAL, k INTEGER, PRIMARY KEY (id)) USING tde_heap;
INSERT INTO test_enc2 (k) VALUES (5), (6);
SELECT * FROM test_enc2 ORDER BY id;
 id | k 
----+---
  1 | 5
  2 | 6
(2 rows)

-- server restart
SELECT * FROM test_enc2 ORDER BY id;
 id | k 
----+---
  1 | 5
  2 | 6
(2 rows)

DROP TABLE test_enc2;
